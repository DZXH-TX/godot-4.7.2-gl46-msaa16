+uint32_t RenderingDeviceDriverVulkan::get_supported_color_attachment_sample_counts(DataFormat p_format, bool p_mutable_format) const {
+	VkImageFormatProperties properties = {};
+	VkImageCreateFlags flags = p_mutable_format ? VK_IMAGE_CREATE_MUTABLE_FORMAT_BIT : 0;
+	VkResult result = vkGetPhysicalDeviceImageFormatProperties(physical_device, RD_TO_VK_FORMAT[p_format],
+			VK_IMAGE_TYPE_2D, VK_IMAGE_TILING_OPTIMAL, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT, flags, &properties);
+	if (result != VK_SUCCESS) {
+		return 0;
+	}
+	// Match the driver's allocation and pipeline sample-count selection, including
+	// its conservative depth limit, so callers cannot mistake a fallback for 16x.
+	return properties.sampleCounts & physical_device_properties.limits.framebufferColorSampleCounts & physical_device_properties.limits.framebufferDepthSampleCounts;
+}
