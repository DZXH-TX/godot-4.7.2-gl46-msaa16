index 0000000..6eb361a
--- /dev/null
+++ b/drivers/gles3/gl46_canvas_buffer.cpp
@@ -0,0 +1,88 @@
+#include "gl46_canvas_buffer.h"
+
+#ifdef GLES3_ENABLED
+#include "core/string/print_string.h"
+#include "core/string/ustring.h"
+#include "core/variant/variant.h"
+
+#ifdef WINDOWS_ENABLED
+#include <windows.h>
+
+namespace {
+using CreateBuffers = void(APIENTRY *)(GLsizei, GLuint *);
+using NamedBufferStorage = void(APIENTRY *)(GLuint, GLsizeiptr, const void *, GLbitfield);
+using MapNamedBufferRange = void *(APIENTRY *)(GLuint, GLintptr, GLsizeiptr, GLbitfield);
+using UnmapNamedBuffer = GLboolean(APIENTRY *)(GLuint);
+CreateBuffers create_buffers = nullptr;
+NamedBufferStorage named_buffer_storage = nullptr;
+MapNamedBufferRange map_named_buffer_range = nullptr;
+UnmapNamedBuffer unmap_named_buffer = nullptr;
+// ARB_buffer_storage, core since OpenGL 4.4.
+constexpr GLbitfield MAP_PERSISTENT = 0x0040;
+constexpr GLbitfield MAP_COHERENT = 0x0080;
+}
+#endif
+
+bool GL46CanvasBuffer::initialize() {
+#ifdef WINDOWS_ENABLED
+	const char *version = reinterpret_cast<const char *>(glGetString(GL_VERSION));
+	if (!version || String(version).begins_with("OpenGL ES")) {
+		return false;
+	}
+	GLint major = 0;
+	GLint minor = 0;
+	glGetIntegerv(GL_MAJOR_VERSION, &major);
+	glGetIntegerv(GL_MINOR_VERSION, &minor);
+	if (major < 4 || (major == 4 && minor < 6)) {
+		return false;
+	}
+	// Load only the four desktop entry points; do not alter the shared GLES loader.
+	HMODULE library = GetModuleHandleW(L"opengl32.dll");
+	using GetProc = PROC(WINAPI *)(LPCSTR);
+	GetProc get_proc = library ? reinterpret_cast<GetProc>(GetProcAddress(library, "wglGetProcAddress")) : nullptr;
+	if (!get_proc) {
+		return false;
+	}
+	auto load = [get_proc](const char *p_name) -> PROC {
+		PROC entry = get_proc(p_name);
+		uintptr_t value = reinterpret_cast<uintptr_t>(entry);
+		return value <= 3 || value == UINTPTR_MAX ? nullptr : entry;
+	};
+	create_buffers = reinterpret_cast<CreateBuffers>(load("glCreateBuffers"));
+	named_buffer_storage = reinterpret_cast<NamedBufferStorage>(load("glNamedBufferStorage"));
+	map_named_buffer_range = reinterpret_cast<MapNamedBufferRange>(load("glMapNamedBufferRange"));
+	unmap_named_buffer = reinterpret_cast<UnmapNamedBuffer>(load("glUnmapNamedBuffer"));
+	return create_buffers && named_buffer_storage && map_named_buffer_range && unmap_named_buffer;
+#else
+	return false;
+#endif
+}
+
+uint8_t *GL46CanvasBuffer::create(GLuint &r_buffer, uint32_t p_size) {
+#ifdef WINDOWS_ENABLED
+	create_buffers(1, &r_buffer);
+	const GLbitfield flags = GL_MAP_WRITE_BIT | MAP_PERSISTENT | MAP_COHERENT;
+	named_buffer_storage(r_buffer, p_size, nullptr, flags);
+	uint8_t *mapping = static_cast<uint8_t *>(map_named_buffer_range(r_buffer, 0, p_size, flags));
+	if (!mapping) {
+		glDeleteBuffers(1, &r_buffer);
+		r_buffer = 0;
+		return nullptr;
+	}
+	static bool reported = false;
+	if (!reported) {
+		print_line("TL_GL46: DSA immutable storage + persistent coherent canvas instance buffers active");
+		reported = true;
+	}
+	return mapping;
+#else
+	return nullptr;
+#endif
+}
+
+void GL46CanvasBuffer::unmap(GLuint p_buffer) {
+#ifdef WINDOWS_ENABLED
+	unmap_named_buffer(p_buffer);
+#endif
+}
+#endif
