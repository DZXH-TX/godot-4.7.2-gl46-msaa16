+#pragma once
+
+#ifdef GLES3_ENABLED
+#include <cstdint>
+#include <platform_gl.h>
+
+// Desktop-only streaming storage. GLES/ANGLE retain the existing allocation path.
+class GL46CanvasBuffer {
+public:
+	static bool initialize();
+	static uint8_t *create(GLuint &r_buffer, uint32_t p_size);
+	static void unmap(GLuint p_buffer);
+};
+#endif
